# Белый список: по умолчанию игнорируется всё, разрешённое перечислено явно.
*
!*/

!/.gitignore
!/.gitattributes
!/.editorconfig
!/.dockerignore
!/README.md
!/LICENSE
!/Dockerfile
!/.env.example
!/docs/**
!/scripts/**
!/.github/**

# Rust
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/rustfmt.toml
!/clippy.toml
!/deny.toml
!/openapi.yaml
!/API.md
!/src/**
!/crates/**
!/tests/**
!/benches/**
!/examples/**
!/fixtures/**
!/fuzz/**
!/migrations/**

# Артефакты
**/target/
# Корпус и находки фаззинга создаются при прогоне
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/
# Схемы, которые tauri-build генерирует при каждой сборке
**/gen/schemas/
**/*.profraw

# Секреты — никогда
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Мусор ОС и редакторов
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
